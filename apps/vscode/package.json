{
  "name": "unravel-code",
  "displayName": "Unravel Code",
  "description": "Explain selected code or a regex, step by step, in Turkish or English.",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "publisher": "unravel-code",
  "repository": {
    "type": "git",
    "url": "https://github.com/KAYACI0/unravel-code.git",
    "directory": "apps/vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Machine Learning", "Education", "Other"],
  "keywords": ["explain", "regex", "legacy", "ai", "tr"],
  "icon": "icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "unravelCode.explain",
        "title": "Unravel: Explain Selection"
      },
      {
        "command": "unravelCode.explainRegex",
        "title": "Unravel: Explain as Regex"
      },
      {
        "command": "unravelCode.setApiKey",
        "title": "Unravel: Set API Key"
      },
      {
        "command": "unravelCode.clearApiKey",
        "title": "Unravel: Clear API Key"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "unravelCode.explain",
          "when": "editorHasSelection",
          "group": "unravel"
        },
        {
          "command": "unravelCode.explainRegex",
          "when": "editorHasSelection",
          "group": "unravel"
        }
      ]
    },
    "keybindings": [
      {
        "command": "unravelCode.explain",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Unravel Code",
      "properties": {
        "unravelCode.auth": {
          "type": "string",
          "enum": ["claudeCode", "vscodeLm", "auto", "apiKey"],
          "enumDescriptions": [
            "Use the locally installed Claude Code and your Claude subscription. No API key needed.",
            "Use whatever language model the editor provides (e.g. GitHub Copilot, including its free tier). No API key needed.",
            "Use a stored API key when there is one, otherwise Claude Code.",
            "Always use the Anthropic API key stored in SecretStorage."
          ],
          "default": "claudeCode",
          "description": "Where the credential comes from. The default 'claudeCode' uses a locally installed Claude Code and bills your Claude subscription - no API key, nothing for Unravel to store."
        },
        "unravelCode.claudeCodePath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the Claude Code executable. Leave empty to detect it automatically."
        },
        "unravelCode.language": {
          "type": "string",
          "enum": ["auto", "tr", "en"],
          "default": "auto",
          "description": "Explanation language. 'auto' follows the VS Code display language."
        },
        "unravelCode.detail": {
          "type": "string",
          "enum": ["brief", "detailed"],
          "default": "detailed",
          "description": "Explanation depth."
        },
        "unravelCode.model": {
          "type": "string",
          "enum": ["claude-haiku-4-5", "claude-sonnet-5"],
          "default": "claude-haiku-4-5",
          "description": "Anthropic model used to generate explanations."
        },
        "unravelCode.contextLines": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Lines of surrounding code (before/after the selection) sent along for context. 0 sends only the selection."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "package": "pnpm build && vsce package --no-dependencies --no-yarn",
    "compile-tests": "tsc -p tsconfig.test.json",
    "test:e2e": "pnpm build && pnpm compile-tests && vscode-test"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.5",
    "@types/vscode": "^1.90.0",
    "@unravel-code/core": "workspace:*",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "markdown-it": "^15.0.2",
    "mocha": "^12.0.2",
    "typescript": "^5.7.2"
  }
}
